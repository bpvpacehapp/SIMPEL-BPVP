# Database PostgreSQL Lokal
DATABASE_URL="postgresql://postgres:GANTI_PASSWORD_POSTGRES@localhost:5432/simple_bpvp?schema=public"

# Identitas Aplikasi
NEXT_PUBLIC_APP_ID="simpel"
NEXT_PUBLIC_APP_NAME="SIMPEL BPVP"
NEXTAUTH_URL="http://localhost:8085"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# Integrasi Central SSO BPVP
# Saat integrasi asli, arahkan ke https://sso.bpvpaceh.id atau http://<ip_sso>:8081
NEXT_PUBLIC_SSO_URL="http://localhost:8085/dev/mock-sso"
SSO_SECRET="ganti-agar-identik-dengan-sso-secret-server-sso"

# Integrasi Master Pegawai SIMPEG BPVP
# Saat integrasi asli, arahkan ke https://simpeg.bpvpaceh.id atau http://<ip_simpeg>:8082
SIMPEG_API_URL="http://localhost:8082"
SIMPEG_API_KEY="dev-simpeg-api-key"

# Mode Mock SIMPEG sementara (set "false" jika SIMPEG_API_KEY asli sudah diberikan)
ENABLE_SIMPEG_MOCK="false"

# Seed Super Admin Pertama
SEED_SUPERADMIN_EMAIL="admin@bpvp.kemnaker.go.id"
SEED_SUPERADMIN_NAMA="Administrator Sistem"
