generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ADMIN_SUB_UNIT
  USER
}

model User {
  id             String    @id @default(cuid())
  nama           String
  email          String    @unique
  nip            String?   @unique
  jabatan        String?
  unitKerja      String?   @map("unit_kerja")
  subUnitKerja   String?   @map("sub_unit_kerja")
  role           Role      @default(USER)
  deletedAt      DateTime? @map("deleted_at")
  password       String?
  fotoUrl        String?   @map("foto_url")
  pegawaiId      String?   @map("pegawai_id")
  sessionToken   String?   @map("session_token") @db.Text
  tokenExpiredAt DateTime? @map("token_expired_at")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  logs            LogAktivitas[]
  menuPermissions UserMenuPermission[]

  @@index([deletedAt])
  @@map("users")
}

model LogAktivitas {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi        String
  modul       String
  detail      String?
  dataSebelum Json?    @map("data_sebelum")
  dataSesudah Json?    @map("data_sesudah")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([modul])
  @@map("log_aktivitas")
}

model SkkniDocument {
  id           String      @id // ID UUID asli dari API SKKNI Kemnaker (tidak generate ID baru)
  number       String?
  numberKepmen String      @map("number_kepmen")
  year         Int?
  sector       String
  title        String?
  agencyId     String?     @map("agency_id")
  agencyName   String?     @map("agency_name")
  availability String      // "applied" | "cancelled"
  status       String?
  notes        String?     @db.Text
  publishedAt  String?     @map("published_at")
  fileName     String?     @map("file_name")
  filePath     String?     @map("file_path")
  tags         Json?
  syncedAt     DateTime    @default(now()) @map("synced_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  units         SkkniUnit[]
  proglatTopics ProglatTopic[]

  @@index([availability])
  @@index([numberKepmen])
  @@index([year])
  @@index([agencyName])
  @@map("skkni_documents")
}

model SkkniUnit {
  id           String        @id // ID UUID asli dari API SKKNI Kemnaker (tidak generate ID baru)
  documentId   String        @map("document_id")
  document     SkkniDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  code         String
  title        String
  titleEn       String?        @map("title_en")
  availability  String?
  proglatTopics ProglatTopic[]

  @@index([documentId])
  @@index([code])
  @@map("skkni_units")
}

model RoleMenuPermission {
  id        String   @id @default(cuid())
  role      Role
  menuKey   String   @map("menu_key")
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, menuKey])
  @@index([role])
  @@map("role_menu_permissions")
}

model UserMenuPermission {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuKey   String   @map("menu_key")
  allowed   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, menuKey])
  @@index([userId])
  @@map("user_menu_permissions")
}

model ProglatProgram {
  id                  String         @id // UUID asli dari API Proglat Kemnaker (tidak generate ID baru)
  category            String         @default("UNIT_SKKNI") // "UNIT_SKKNI" | "SOFTSKILL_PRODUKTIVITAS"
  code                String?
  title               String
  totalModules        Int            @default(0) @map("total_modules")
  totalDuration       Int            @default(0) @map("total_duration")
  type                String?
  publishedAt         DateTime?      @map("published_at")
  coverImage          String?        @map("cover_image")
  downloadMaterialUri String?        @map("download_material_uri")
  vocationalName      String?        @map("vocational_name")
  subVocationalName   String?        @map("sub_vocational_name")
  status              String?
  version             Int            @default(1)
  isManualEdited      Boolean        @default(false) @map("is_manual_edited")
  originalSnapshot    Json?          @map("original_snapshot")
  deletedAt           DateTime?      @map("deleted_at")
  syncedAt            DateTime       @default(now()) @map("synced_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  topics              ProglatTopic[]
  jenisUnitLinks      JenisUnitKompetensi[] @relation("JenisUnitProgram")

  @@index([category])
  @@index([code])
  @@index([type])
  @@index([vocationalName])
  @@index([deletedAt])
  @@map("proglat_programs")
}

model ProglatTopic {
  id             String               @id // UUID asli dari API Proglat Kemnaker (tidak generate ID baru)
  programId      String               @map("program_id")
  program        ProglatProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  code           String?              // Kode SKKNI atau --Spesial (tidak diubah saat edit manual)
  title          String
  duration       Int                  @default(0)
  references     String?              @db.Text
  description    String?              @db.Text
  type           String?              // "skkni" | "special" | lainnya
  jenisUnitId    String?              @map("jenis_unit_id")
  jenisUnit      JenisUnitKompetensi? @relation(fields: [jenisUnitId], references: [id], onDelete: Restrict)
  skkniId        String?              @map("skkni_id")
  skkniDocument  SkkniDocument?       @relation(fields: [skkniId], references: [id], onDelete: Restrict)
  skkniUnitId    String?              @map("skkni_unit_id")
  skkniUnit      SkkniUnit?           @relation(fields: [skkniUnitId], references: [id], onDelete: Restrict)
  isManualEdited Boolean              @default(false) @map("is_manual_edited")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([programId])
  @@index([code])
  @@index([jenisUnitId])
  @@index([skkniId])
  @@index([skkniUnitId])
  @@map("proglat_topics")
}

model JenisUnitKompetensi {
  id                         String          @id @default(cuid())
  jenisUnit                  String          @map("jenis_unit")
  memilikiSk                 Boolean         @default(false) @map("memiliki_sk")
  memilikiSuratKeputusan     Boolean         @default(false) @map("memiliki_surat_keputusan")
  memilikiProgramTersendiri  Boolean         @default(false) @map("memiliki_program_tersendiri")
  programId                  String?         @map("program_id")
  program                    ProglatProgram? @relation("JenisUnitProgram", fields: [programId], references: [id], onDelete: Restrict)
  deletedAt                  DateTime?       @map("deleted_at")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  topics                     ProglatTopic[]

  @@index([deletedAt])
  @@index([jenisUnit])
  @@index([programId])
  @@map("jenis_unit_kompetensi")
}

model JenisPelatihan {
  id             String    @id @default(cuid())
  jenisPelatihan String    @map("jenis_pelatihan")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt])
  @@index([jenisPelatihan])
  @@map("jenis_pelatihan")
}
